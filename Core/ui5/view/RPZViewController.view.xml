<mvc:View
    controllerName="fw.controller.RPZViewController"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
    xmlns:l="sap.ui.layout"
    xmlns="sap.m"
    class="sapUiSizeCompact"
    >

   <Dialog title="test" class="sapUiSizeCompact" id="viewController" draggable="true" resizable="true" >

    <customHeader>
        <Bar>
            <contentMiddle>
                <Title id="vname" text="RPZ View Controller" />
            </contentMiddle>
        </Bar>
    </customHeader>
    <IconTabBar class="fwIconTab" headerMode="Inline" >
    <items>
		<IconTabFilter text="Style" icon="sap-icon://edit">
           <content>
           <l:VerticalLayout >
            <CheckBox text="Black Background" id="blackbg" select="blackBackground"/>
            <CheckBox text="Event Label" id="eventLabel" selected="{/showEventLabel}" select="showEventLabel"/>
            <CheckBox text="Projection Axes" selected="{/projectionAxes}" select="showProjectionAxes"/>
            <!--CheckBox text="Line Width" selected="{/ecalBarrel}" id="lineWidth" select="setLineWidth"/>
            <l:HorizontalLayout>
            <Text text="lineWidth" class="sapUiTinyMargin"/>
            <StepInput width="30px" value="2" max="5" min="1" id="lw"/>
            </l:HorizontalLayout-->
           </l:VerticalLayout>
           </content>
        </IconTabFilter>
		<IconTabFilter text="Geometry" icon="sap-icon://add"  >
           <content>
           <l:VerticalLayout >
            <CheckBox text="show Pixel Barrel" selected="{/pixelBarrel}" select="showPixelBarrel"/>
            <CheckBox text="show Pixel Endcap" selected="{/pixelEndcap}" select="showPixelEndcap"/>
            <CheckBox text="show Tracker Barrel"  selected="{/trackerBarrel}" select="showTrackerBarrel"/>
            <CheckBox text="show Tracker Endcap" selected="{/trackerEndcap}" select="showTrackerEndcap"/>
            <CheckBox text="show RPC Endcap" selected="{/rpcEndcap}" select="showRpcEndcap"/>
            <CheckBox text="show GEM" selected="{/gem}" select="showGEM"/>
            <CheckBox text="show ME0" selected="{/meo}" select="showME0"/>
            <CheckBox text="show MTD Endcap" selected="{/MtdEndcap}" select="showMtdEndcap"/>
           </l:VerticalLayout>
           </content>
        </IconTabFilter>
        <IconTabFilter text="Calo" icon="sap-icon://co">
           <content>
           <l:VerticalLayout>
            <CheckBox text="Include Endcaps" selected="{/includeEndcaps}" select="setEtaRange"/>
           </l:VerticalLayout>
           </content>
        </IconTabFilter>
        <IconTabFilter text="Projection" icon="sap-icon://resize">
           <content>
           <l:VerticalLayout class="sapUiSmallMargin">
            <Label text="Fisheye Distortion"/>
            <l:HorizontalLayout>
                <Button text="&lt;&lt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeDistortion"/>
                        <core:CustomData key="fn" value="setFishEyeDistortion"/>
                        <core:CustomData key="max" value="100"/>
                        <core:CustomData key="step" value="-10"/>
                    </customData>
                </Button>
                <Button text="&lt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeDistortion"/>
                        <core:CustomData key="fn" value="setFishEyeDistortion"/>
                        <core:CustomData key="max" value="100"/>
                        <core:CustomData key="step" value="-1"/>
                    </customData>
                </Button>
                <Text text="{/fishEyeDistortion}" width="3em" textAlign="Center" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
                <Button text="&gt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeDistortion"/>
                        <core:CustomData key="fn" value="setFishEyeDistortion"/>
                        <core:CustomData key="max" value="100"/>
                        <core:CustomData key="step" value="1"/>
                    </customData>
                </Button>
                <Button text="&gt;&gt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeDistortion"/>
                        <core:CustomData key="fn" value="setFishEyeDistortion"/>
                        <core:CustomData key="max" value="100"/>
                        <core:CustomData key="step" value="10"/>
                    </customData>
                </Button>
            </l:HorizontalLayout>

            <Label text="Fixed Radius" class="sapUiSmallMarginTop"/>
            <l:HorizontalLayout>
                <Button text="&lt;&lt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeR"/>
                        <core:CustomData key="fn" value="setFishEyeR"/>
                        <core:CustomData key="max" value="150"/>
                        <core:CustomData key="step" value="-10"/>
                    </customData>
                </Button>
                <Button text="&lt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeR"/>
                        <core:CustomData key="fn" value="setFishEyeR"/>
                        <core:CustomData key="max" value="150"/>
                        <core:CustomData key="step" value="-1"/>
                    </customData>
                </Button>
                <Text text="{/fishEyeR}" width="3em" textAlign="Center" class="sapUiTinyMarginTop sapUiTinyMarginEnd"/>
                <Button text="&gt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeR"/>
                        <core:CustomData key="fn" value="setFishEyeR"/>
                        <core:CustomData key="max" value="150"/>
                        <core:CustomData key="step" value="1"/>
                    </customData>
                </Button>
                <Button text="&gt;&gt;" press="onFishEyeStep" class="sapUiTinyMarginEnd">
                    <customData>
                        <core:CustomData key="prop" value="fishEyeR"/>
                        <core:CustomData key="fn" value="setFishEyeR"/>
                        <core:CustomData key="max" value="150"/>
                        <core:CustomData key="step" value="10"/>
                    </customData>
                </Button>
            </l:HorizontalLayout>
            <Label text="Projection Axes Font Size" class="sapUiSmallMarginTop"/>
            <Slider
                width="100%"
                min="0.001"
                max="0.05"
                step="0.0005"
                value="{/projectionAxesFontSize}"
                inputsAsTooltips="true"
                change="onProjectionAxesFontSizeChange"/>
            <l:HorizontalLayout>
                <Text text="Value: " class="sapUiTinyMarginEnd"/>
                <Text text="{/projectionAxesFontSize}"/>
            </l:HorizontalLayout>
           </l:VerticalLayout>
           </content>
        </IconTabFilter>

    </items>
    </IconTabBar>
    <endButton>
        <Button text="Close" tooltip="Close dialog (or press Esc key)"  press="onClose"/>
    </endButton>
   </Dialog>
</mvc:View>
